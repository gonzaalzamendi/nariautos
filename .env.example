# URL y clave pública del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreto del servidor (solo servidor). Su hash SHA-256 se guarda en private.config (ver README)
SUPABASE_SERVER_SECRET=
# URL pública del chatbot de Dify (Publicar > Incrustar en sitios web). Si falta, no se muestra el botón
NEXT_PUBLIC_DIFY_CHAT_URL=
# Secreto para firmar las sesiones de empleados (solo servidor)
SESSION_SECRET=
